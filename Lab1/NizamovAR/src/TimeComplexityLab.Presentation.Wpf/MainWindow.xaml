<Window x:Class="TimeComplexityLab.Presentation.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:TimeComplexityLab.Presentation.Wpf.Views"
        Title="Лаборатория Временной Сложности v1.0"
        Height="820" Width="1350"
        Background="{StaticResource AppBackgroundBrush}">
    <TabControl Margin="12" Padding="6">
        <TabItem Header="📈 Эксперимент">
            <v:ExperimentView/>
        </TabItem>
        <TabItem Header="📜 История">
            <v:HistoryView/>
        </TabItem>
        <TabItem Header="🌐 3D-поверхность">
            <v:SurfaceView/>
        </TabItem>
        <TabItem Header="🚀 Автозапуск">
            <v:AutoRunView/>
        </TabItem>
    </TabControl>
</Window>