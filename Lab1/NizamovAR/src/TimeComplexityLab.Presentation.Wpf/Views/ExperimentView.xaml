<UserControl x:Class="TimeComplexityLab.Presentation.Wpf.Views.ExperimentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:scott="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF">
    <Grid>
		<Grid Margin="15">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="280"/>
				<ColumnDefinition Width="*"/>
			</Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,15,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
					<StackPanel>
						<TextBlock Text="Параметры эксперимента"
								   FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>

						<TextBlock Text="Алгоритм:" Margin="0,5,0,2"/>
						<ComboBox x:Name="AlgoComboBox"
								  DisplayMemberPath="DisplayName"
								  Height="30" Margin="0,0,0,15"
								  SelectionChanged="AlgoComboBox_SelectionChanged"/>

						<TextBlock Text="N Max:" Margin="0,5,0,2"/>
						<TextBox x:Name="TxtNMax" Text="5000"
								 Height="30" VerticalContentAlignment="Center" Margin="0,0,0,10"/>

						<TextBlock Text="Шаг N:" Margin="0,5,0,2"/>
						<TextBox x:Name="TxtStep" Text="500"
								 Height="30" VerticalContentAlignment="Center" Margin="0,0,0,10"/>

						<StackPanel x:Name="TwoDimPanel" Visibility="Collapsed">
							<TextBlock Text="M Max:" Margin="0,5,0,2"/>
							<TextBox x:Name="TxtMMax" Text="500"
									 Height="30" VerticalContentAlignment="Center" Margin="0,0,0,10"/>

							<TextBlock Text="Шаг M:" Margin="0,5,0,2"/>
							<TextBox x:Name="TxtMStep" Text="50"
									 Height="30" VerticalContentAlignment="Center" Margin="0,0,0,10"/>
						</StackPanel>

						<TextBlock Text="Запусков на точку:" Margin="0,5,0,2"/>
						<TextBox x:Name="TxtRuns" Text="5"
								 Height="30" VerticalContentAlignment="Center" Margin="0,0,0,10"/>

						<CheckBox x:Name="ChkForceRecalc"
								  Content="Принудительный пересчёт (игнорировать кэш)"
								  Margin="0,5,0,15"
								  Foreground="#495057"
								  VerticalContentAlignment="Center"/>

						<TextBlock Text="Гипотеза f(n):" Margin="0,5,0,2"/>
						<ComboBox x:Name="HypothesisComboBox"
								  Height="30" Margin="0,0,0,15">
							<ComboBoxItem Content="O(n)" Tag="Linear" IsSelected="True"/>
							<ComboBoxItem Content="O(1)" Tag="Constant"/>
							<ComboBoxItem Content="O(log n)" Tag="Logarithmic"/>
							<ComboBoxItem Content="O(n log n)" Tag="NLogN"/>
							<ComboBoxItem Content="O(n²)" Tag="Quadratic"/>
							<ComboBoxItem Content="O(n³)" Tag="Cubic"/>
						</ComboBox>

						<TextBlock Text="Аппроксимация:" FontWeight="SemiBold" Margin="0,10,0,2"/>
						<TextBlock x:Name="ApproxInfoText"
								   Text="—"
								   TextWrapping="Wrap"
								   Foreground="#495057"
								   Margin="0,0,0,15"/>

                        <Button Content="▶ Запустить бенчмарк"
								Style="{StaticResource PrimaryButton}"
								Height="42"
								Click="BtnStart_Click"/>

                        <Button Content="＋ Наложить на график"
								Style="{StaticResource SuccessButton}"
								Height="34"
								Margin="0,8,0,0"
								Click="BtnCompare_Click"/>		

                        <Button Content="Очистить график"
								Style="{StaticResource SecondaryButton}"
								Height="30"
								Margin="0,8,0,0"
								Click="BtnClear_Click"/>
                    </StackPanel>
				</ScrollViewer>
			</Border>

            <Border Grid.Column="1" Style="{StaticResource CardBorder}" Padding="10">
                <scott:WpfPlot x:Name="MainPlot"/>
			</Border>
		</Grid>
    </Grid>
</UserControl>