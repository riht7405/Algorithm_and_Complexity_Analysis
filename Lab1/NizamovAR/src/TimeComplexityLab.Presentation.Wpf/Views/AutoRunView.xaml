<UserControl x:Class="TimeComplexityLab.Presentation.Wpf.Views.AutoRunView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Верхняя панель управления -->
        <Border Grid.Row="0"
                Style="{StaticResource CardBorder}"
                Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="BtnRun"
                        Grid.Column="0"
                        Content="▶ Запустить все алгоритмы"
                        Style="{StaticResource SuccessButton}"
                        Height="42" Width="270"
                        Margin="0,0,12,0"
                        Click="BtnRun_Click"/>

                <Button x:Name="BtnStop"
                        Grid.Column="1"
                        Content="⏹ Остановить"
                        Style="{StaticResource DangerButton}"
                        Height="42" Width="140"
                        IsEnabled="False"
                        Margin="0,0,20,0"
                        Click="BtnStop_Click"/>

                <CheckBox x:Name="ChkForceRecalc"
                          Grid.Column="2"
                          Content="Принудительный&#x0a;пересчёт"
                          VerticalAlignment="Center"
                          FontSize="12"
                          Foreground="{StaticResource TextSecondaryBrush}"
                          Margin="0,0,20,0"/>

                <StackPanel Grid.Column="3" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusText"
                               Text="Готов к запуску. Будут запущены все 15 алгоритмов с параметрами по умолчанию."
                               FontSize="13"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,0,0,8"/>

                    <ProgressBar x:Name="ProgressBar"
                                 Height="8"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="0"
                                 Foreground="#198754"
                                 Background="#E9ECEF"
                                 BorderThickness="0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Вложенные вкладки с результатами -->
        <Border Grid.Row="1"
                Style="{StaticResource CardBorder}"
                Padding="8">
            <TabControl x:Name="ResultsTabControl"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="4">
                <TabItem Header="(здесь появятся результаты)">
                    <TextBlock Text="Нажми «Запустить все алгоритмы», чтобы начать."
                               FontSize="16"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                </TabItem>
            </TabControl>
        </Border>
    </Grid>
</UserControl>