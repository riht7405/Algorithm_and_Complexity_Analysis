<UserControl x:Class="TimeComplexityLab.Presentation.Wpf.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:scott="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
             Loaded="OnLoaded">
    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="440"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Левая панель: список сессий -->
        <Border Grid.Column="0"
                Style="{StaticResource CardBorder}"
                Margin="0,0,15,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="История экспериментов"
                           FontSize="18" FontWeight="Bold"
                           Foreground="#212529"
                           Margin="0,0,0,10"/>

                <TextBlock Grid.Row="1"
                           Text="Ctrl+клик — выбрать несколько сессий. Двойной клик — построить для одной."
                           FontSize="12"
                           Foreground="#6C757D"
                           TextWrapping="Wrap"
                           Margin="0,0,0,10"/>

                <DataGrid x:Name="SessionsGrid"
                          Grid.Row="2"
                          Style="{StaticResource ModernDataGrid}"
                          SelectionMode="Extended"
                          SelectionChanged="SessionsGrid_SelectionChanged"
                          MouseDoubleClick="SessionsGrid_MouseDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Дата"
                                            Binding="{Binding StartedAtUtc, StringFormat='dd.MM HH:mm:ss'}"
                                            Width="110"/>
                        <DataGridTextColumn Header="Алгоритм"
                                            Binding="{Binding DisplayName}"
                                            Width="*"/>
                        <DataGridTextColumn Header="N max"
                                            Binding="{Binding NMax}"
                                            Width="60"/>
                        <DataGridTextColumn Header="M max"
                                            Binding="{Binding MMax}"
                                            Width="55"/>
                        <DataGridTextColumn Header="Точек"
                                            Binding="{Binding PointCount}"
                                            Width="50"/>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel Grid.Row="3"
                            Orientation="Vertical"
                            Margin="0,10,0,0">
                    <Button Content="📈 Построить график для выбранных"
                            Click="BtnPlotSelected_Click"
                            Style="{StaticResource PrimaryButton}"
                            Height="38"
                            Margin="0,0,0,6"/>

                    <Button Content="🔺 Показать в 3D"
                            Click="BtnShow3D_Click"
                            Style="{StaticResource AccentButton}"
                            Height="34"
                            Margin="0,0,0,6"/>

                    <Button Content="🗑 Удалить выбранную"
                            Click="BtnDelete_Click"
                            Style="{StaticResource DangerButton}"
                            Height="30"
                            Margin="0,0,0,6"/>

                    <Button Content="🔄 Обновить список"
                            Click="BtnRefresh_Click"
                            Style="{StaticResource SecondaryButton}"
                            Height="30"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Правая панель: график -->
        <Border Grid.Column="1"
                Style="{StaticResource CardBorder}"
                Padding="10">
            <scott:WpfPlot x:Name="HistoryPlot"/>
        </Border>
    </Grid>
</UserControl>